#!/bin/bash
# {{ ansible_managed }}
# Alerts on log entries matching a pattern that were written since the
# previous run; a streak of errors alerts once.

set -euo pipefail

NOTIFY="{{ monitoring_scripts_path }}/monitoring-notify"
STATE_DIR="{{ monitoring_state_dir }}/check-logfiles"
/usr/bin/mkdir -p "$STATE_DIR"

new_bytes() {
    local file="$1" offset_file="$2" size last
    size=$(/usr/bin/stat -c%s "$file")
    last=$(cat "$offset_file")
    if [ "$size" -lt "$last" ]; then
        if [ -f "${file}.1" ] && [ "$(/usr/bin/stat -c%s "${file}.1")" -gt "$last" ]; then
            /usr/bin/tail -c +$((last + 1)) "${file}.1"
        fi
        last=0
    fi
    echo "$size" > "$offset_file"
    /usr/bin/tail -c +$((last + 1)) "$file" | /usr/bin/head -c $((size - last)) || true
}

join_entries() {
    /usr/bin/awk -v re="$1" '
        $0 ~ re { if (started) print buf; buf = $0; started = 1; next }
        started { buf = buf " " $0 }
        END     { if (started) print buf }
    '
}

check_log() {
    local name="$1" path="$2" pattern="$3" exclude="$4" context="$5" flags="$6"
    local min_matches="$7" entry_start="$8" glob="$9"
    local file offset_file lines count sample
    if [ "$glob" = "true" ]; then
        # shellcheck disable=SC2086
        file=$(/usr/bin/ls -t $path 2>/dev/null | /usr/bin/head -1 || true)
    else
        file="$path"
    fi
    [ -n "$file" ] && [ -f "$file" ] || return 0
    offset_file="${STATE_DIR}/${name}.offset"
    if [ ! -f "$offset_file" ]; then
        /usr/bin/stat -c%s "$file" > "$offset_file"
        return 0
    fi

    lines=$(new_bytes "$file" "$offset_file")
    if [ -n "$entry_start" ]; then
        lines=$(printf '%s\n' "$lines" | join_entries "$entry_start")
    fi
    if [ -n "$exclude" ]; then
        lines=$(printf '%s\n' "$lines" | /usr/bin/grep -av"${flags}"E "$exclude" || true)
    fi
    count=$(printf '%s\n' "$lines" | /usr/bin/grep -ac"${flags}"E "$pattern" || true)

    if [ "$count" -ge "$min_matches" ] && [ "$count" -gt 0 ]; then
        sample=$(printf '%s\n' "$lines" | /usr/bin/grep -a"${flags}"E -A "$context" "$pattern" | /usr/bin/tail -20)
        "$NOTIFY" alert "logfiles-${name}" "${name}: ${count} new error(s) in ${file}
${sample}"
    else
        "$NOTIFY" clear "logfiles-${name}" ""
    fi
}

{% for log in monitoring_logfile_checks %}
check_log {{ log.name | quote }} {{ log.path | quote }} {{ log.pattern | quote }} {{ log.exclude | default('') | quote }} {{ log.context | default(0) | int }} {{ ('i' if log.ignore_case | default(true) else '') | quote }} {{ log.min_matches | default(1) | int }} {{ log.entry_start | default('') | quote }} {{ log.glob | default(false) | bool | lower }}
{% endfor %}
