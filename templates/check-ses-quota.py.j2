#!/usr/bin/env python3
# {{ ansible_managed }}
# Alert when the SES messages sent over the last 24 hours exceed THRESHOLD
# percent of the account's 24-hour sending quota.

import subprocess
import sys

import boto3
from botocore.credentials import InstanceMetadataFetcher, InstanceMetadataProvider

NOTIFY = {{ (monitoring_scripts_path ~ '/monitoring-notify') | to_json }}
REGION = {{ monitoring_ses_quota_watch.region | default('') | to_json }}
CREDENTIALS = {{ monitoring_ses_quota_watch.credentials | default('default') | to_json }}
THRESHOLD = {{ monitoring_ses_quota_watch.threshold_percent | default(80) | float }}


def notify(*args):
    if subprocess.run([NOTIFY, *args], check=False).returncode != 0:
        print(f"monitoring-notify {args[0]} failed", file=sys.stderr)


def aws_session():
    if CREDENTIALS == "default":
        return boto3.Session(region_name=REGION or None)
    if CREDENTIALS != "instance-profile":
        raise ValueError(f"unknown credentials mode {CREDENTIALS!r}")
    provider = InstanceMetadataProvider(
        iam_role_fetcher=InstanceMetadataFetcher(timeout=2, num_attempts=2)
    )
    creds = provider.load()
    if creds is None:
        raise RuntimeError("no instance profile credentials")
    creds = creds.get_frozen_credentials()
    return boto3.Session(
        aws_access_key_id=creds.access_key,
        aws_secret_access_key=creds.secret_key,
        aws_session_token=creds.token,
        region_name=REGION or None,
    )


try:
    quota = aws_session().client("ses").get_send_quota()
except Exception as e:
    print(f"aws query failed: {e}", file=sys.stderr)
    sys.exit(1)

sent, limit = quota["SentLast24Hours"], quota["Max24HourSend"]
used = 100 * sent / limit if limit else 0
summary = f"{sent:.0f} of {limit:.0f} emails sent in 24h ({used:.0f}%)"

if used > THRESHOLD:
    notify("alert", "ses-quota", f"SES quota above {THRESHOLD:g}%: {summary}")
else:
    notify("clear", "ses-quota", f"SES quota back to normal: {summary}")
